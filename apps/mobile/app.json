{
  "expo": {
    "name": "花哪",
    "slug": "huana",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "scheme": "huana",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.willkan.huana",
      "buildNumber": "1"
    },
    "android": {
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#F6FAF8"
      },
      "package": "com.willkan.huana",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "./plugins/with-android-release-signing",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-dev-client",
      "expo-background-task",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "用于在本机实时识别记账语音；音频不会保存为文件或上传。"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
