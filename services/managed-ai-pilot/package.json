{
  "name": "@bookkeeping/managed-ai-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts src/admin.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --sourcemap --external:better-sqlite3 --external:openai --external:pino --external:zod",
    "start": "node dist/server.js",
    "admin": "tsx src/admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts --max-warnings 0"
  },
  "dependencies": {
    "@bookkeeping/ai-parse-prompt": "0.1.0",
    "@bookkeeping/contracts": "0.1.0",
    "better-sqlite3": "11.8.1",
    "openai": "6.47.0",
    "pino": "10.3.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "22.15.3",
    "@typescript-eslint/parser": "8.26.1",
    "eslint": "9.22.0",
    "esbuild": "0.25.12",
    "tsx": "4.19.3",
    "typescript": "6.0.3",
    "vitest": "3.0.9"
  }
}
